  <build>
    <finalName>intellij-code-formatter</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>--add-exports</arg>
            <arg>java.base/sun.nio.ch=ALL-UNNAMED</arg>
            <arg>--add-exports</arg>
            <arg>java.base/jdk.internal.misc=ALL-UNNAMED</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>1.18.30</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!--
        download-idea uses download-maven-plugin's own "unpack" mode (single execution,
        no maven-antrun-plugin) rather than downloading then unzipping in a separate antrun
        execution. This matters beyond style: maven-antrun-plugin's "run" goal declares
        requiresDependencyResolution=test, so Maven resolves the full dependency graph
        (including these very system-scope IDE jars) BEFORE invoking it — which fails on a
        truly fresh checkout where target/ide doesn't exist yet, since there'd be nothing
        to resolve. download-maven-plugin's "wget" goal has no such requirement, so it can
        run before the jars it produces exist.
      -->
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>1.9.0</version>
        <executions>
          <execution>
            <id>download-idea</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <url>https://download-cdn.jetbrains.com/idea/idea-${idea.version}.win.zip</url>
              <unpack>true</unpack>
              <outputDirectory>${project.build.directory}/ide</outputDirectory>
              <includes>
                <include>lib/app.jar</include>
                <include>lib/util.jar</include>
                <include>lib/util_rt.jar</include>
                <include>lib/util-8.jar</include>
                <include>lib/lib.jar</include>
                <include>lib/jps-model.jar</include>
                <include>lib/module-intellij.libraries.fastutil.jar</include>
                <include>lib/module-intellij.libraries.kotlinx.collections.immutable.jar</include>
                <include>lib/module-intellij.libraries.guava.jar</include>
                <include>lib/opentelemetry.jar</include>
                <include>lib/module-intellij.regexp.jar</include>
                <include>lib/module-intellij.xml.parser.jar</include>
                <include>lib/module-intellij.xml.psi.jar</include>
                <include>lib/module-intellij.xml.psi.impl.jar</include>
                <include>lib/module-intellij.xml.analysis.jar</include>
                <include>lib/module-intellij.xml.analysis.impl.jar</include>
                <include>lib/module-intellij.xml.impl.jar</include>
                <include>lib/module-intellij.xml.ui.common.jar</include>
                <include>lib/module-intellij.xml.syntax.jar</include>
                <include>plugins/java/lib/java-impl.jar</include>
                <include>plugins/java/lib/java-impl-frontend.jar</include>
                <include>plugins/Groovy/lib/Groovy.jar</include>
                <include>plugins/properties/lib/properties.jar</include>
                <include>plugins/yaml/lib/yaml.jar</include>
                <include>plugins/json/lib/json.jar</include>
                <include>plugins/Kotlin/lib/kotlin-plugin.jar</include>
                <include>plugins/Kotlin/lib/kotlin-plugin-shared.jar</include>
                <include>plugins/Kotlin/lib/kotlinc.kotlin-compiler-common.jar</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>unpack-system-scope-jars</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>system</includeScope>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

